{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-rails.com/schemas/dbt_binding.v1.json",
  "title": "Semantic Rails dbt binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "binding_version", "packages"],
  "properties": {
    "kind": {
      "const": "dbt"
    },
    "binding_version": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "policy", "resources"],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": ["error", "warn"]
        },
        "type_check": {
          "enum": ["ignore", "compatible", "exact"]
        },
        "allow_extra_columns": {
          "type": "boolean"
        },
        "require_model_contract": {
          "type": "boolean"
        },
        "require_model_version": {
          "type": "boolean"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_model_id"],
      "properties": {
        "semantic_model_id": {
          "type": "string",
          "minLength": 1
        },
        "dbt_resource_type": {
          "enum": ["model", "source", "seed", "snapshot"]
        },
        "dbt_model": {
          "type": "string",
          "minLength": 1
        },
        "dbt_source_name": {
          "type": "string",
          "minLength": 1
        },
        "dbt_source_table": {
          "type": "string",
          "minLength": 1
        },
        "dbt_package": {
          "type": "string"
        },
        "dbt_version": {
          "type": ["integer", "string"]
        },
        "latest_version": {
          "type": ["integer", "string"]
        },
        "access": {
          "enum": ["private", "protected", "public"]
        },
        "contract_enforced": {
          "type": "boolean"
        },
        "allow_extra_columns": {
          "type": "boolean"
        },
        "require_model_contract": {
          "type": "boolean"
        },
        "require_model_version": {
          "type": "boolean"
        },
        "type_check": {
          "enum": ["ignore", "compatible", "exact"]
        },
        "severity": {
          "enum": ["error", "warn"]
        },
        "dbt_alias": {
          "type": "string"
        },
        "dbt_schema": {
          "type": "string"
        },
        "dbt_database": {
          "type": "string"
        },
        "dbt_identifier": {
          "type": "string"
        },
        "dbt_relation_name": {
          "type": "string"
        }
      }
    }
  }
}
